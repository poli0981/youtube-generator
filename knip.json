{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "worker/**/*.ts",
    "build-plugins/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["tailwindcss", "@testing-library/jest-dom", "@testing-library/react"]
}
